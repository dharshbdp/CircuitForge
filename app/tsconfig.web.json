{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/shared/**/*",
    "src/core/**/*",
    "src/hardware/**/*",
    "src/simulator/**/*",
    "src/ai/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@core": [
        "src/core"
      ],
      "@core/*": [
        "src/core/*"
      ],
      "@hardware": [
        "src/hardware"
      ],
      "@hardware/*": [
        "src/hardware/*"
      ],
      "@simulator": [
        "src/simulator"
      ],
      "@simulator/*": [
        "src/simulator/*"
      ],
      "@ai": [
        "src/ai"
      ],
      "@ai/*": [
        "src/ai/*"
      ],
      "@shared": [
        "src/shared"
      ],
      "@shared/*": [
        "src/shared/*"
      ]
    }
  }
}
