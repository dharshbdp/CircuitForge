{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/core/**/*",
    "src/hardware/**/*",
    "src/simulator/**/*",
    "src/ai/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@core": [
        "src/core"
      ],
      "@core/*": [
        "src/core/*"
      ],
      "@hardware": [
        "src/hardware"
      ],
      "@hardware/*": [
        "src/hardware/*"
      ],
      "@simulator": [
        "src/simulator"
      ],
      "@simulator/*": [
        "src/simulator/*"
      ],
      "@ai": [
        "src/ai"
      ],
      "@ai/*": [
        "src/ai/*"
      ],
      "@shared": [
        "src/shared"
      ],
      "@shared/*": [
        "src/shared/*"
      ]
    }
  }
}
